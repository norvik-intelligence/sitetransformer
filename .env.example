# Vercel Blob: created automatically when you add Blob Storage in Vercel Storage.
BLOB_READ_WRITE_TOKEN=

# Optional AI provider. The app works with deterministic fallback mocks when absent.
AI_API_KEY=
AI_MODEL=gpt-4.1
AI_API_BASE=https://api.openai.com/v1

# Gemini powers the Source → Target content mapping workflow.
GEMINI_API_KEY=

# Optional: block SSRF by tightening allowed clone hosts in production logic.
APP_ORIGIN=http://localhost:3000
